# Reference only: the program deliberately does not auto-load .env files.
# Configure environment variables in your terminal. Never commit real credentials.
WXQ_BASE_URL=https://api.openai.com/v1
WXQ_MODEL=your-text-model
WXQ_VISION_MODEL=your-vision-model
WXQ_API_KEY=
WXQ_TIMEOUT=12
WXQ_TOKEN_LIMIT_FIELD=max_completion_tokens
WXQ_OUTPUT_TOKENS=1400
WXQ_JSON_MODE=1
